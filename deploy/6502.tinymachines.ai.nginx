# 6502.tinymachines.ai -- transistor-level 6502 simulator.
#
# Entirely static: HTML/CSS/JS, a ~110 KB .wasm, and a 1.5 MB die-geometry blob.
# There is no application process; nginx serves files from a release directory
# that 6502-deploy.service swaps a symlink into.

# Cache policy lives in a map rather than in per-location `add_header`, and that
# is load-bearing rather than stylistic. nginx's add_header does not merge
# across levels: a location containing ANY add_header discards every inherited
# one. An earlier version set Cache-Control per location and silently dropped
# the CSP and HSTS headers from the HTML document -- the one response where they
# actually matter. With the value in a variable, every header can be declared
# once at server level and no location needs add_header at all.
#
# Assets are content-hashed by tools/build-web.py, so a given URL's bytes can
# never change and `immutable` is honest rather than a gamble. index.html and
# sw.js are the entry points and must never be held: they are what point at the
# hashed names, and a stale sw.js would pin an old build indefinitely.
#
# The hashed pattern is listed first: nginx evaluates map regexes in order, and
# putting the specific case ahead of the general one keeps it that way if more
# rules are added later.
map $uri $tm6502_cache {
    default                                                   "public, max-age=60, must-revalidate";
    # Quoted: nginx parses a bare { in a map key as the start of a block.
    # `json` is here for the derived blueprint, and it is safe only because the
    # pattern demands the hash segment: build-info.json has none, so it keeps
    # the short default -- which is the point of it, since its whole job is to
    # report the deploy that just happened.
    "~*\.[0-9a-f]{8}\.(?:js|css|wasm|bin|png|svg|json|webmanifest)$"  "public, max-age=31536000, immutable";
    # Archive imagery: mirrored third-party originals and their generated
    # thumbnails. Not content-hashed, but these are archived bytes -- a file
    # only changes if the upstream original does, which is the event this
    # whole archive exists because it is not happening any more. A week is a
    # compromise: long enough that a 244 MB scan is not refetched, short
    # enough that a re-harvest propagates without renaming anything.
    ~^/archive/(?:full|gallery/(?:thumb|view))/                "public, max-age=604800";
    ~*\.html$                                                  "no-cache";
    # Bare page paths (/schematic, /blueprint, ...). They resolve to HTML via
    # try_files, so they need HTML's caching -- without this they fall to the
    # 60-second default and a deploy takes a minute to show up on exactly the
    # URLs the site advertises. Matching "no dot in the path" rather than
    # listing the pages means a new page cannot be forgotten here; the archive
    # rule above still claims its own paths first.
    ~^/[^.]*$                                                  "no-cache";
    "/"                                                        "no-cache";
    "/sw.js"                                                   "no-cache";
}

server {
    include snippets/scanner-trap.conf;
    server_name 6502.tinymachines.ai;
    listen 80;
    listen [::]:80;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    include snippets/scanner-trap.conf;
    server_name 6502.tinymachines.ai;

    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    # Issued by:
    #   certbot certonly --webroot -w /var/www/html -d 6502.tinymachines.ai
    # Note this box's snakeoil pair is broken (the .pem holds a private key), so
    # the usual "bootstrap with snakeoil, let certbot replace it" trick does not
    # work here -- this vhost was brought up HTTP-only first instead.
    ssl_certificate     /etc/letsencrypt/live/6502.tinymachines.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/6502.tinymachines.ai/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/6502.tinymachines.ai/current;
    index index.html;

    access_log /var/log/nginx/6502.access.log;
    error_log  /var/log/nginx/6502.error.log;

    # The deploy precompresses everything with gzip -9, so nginx never spends CPU
    # compressing. This is not an optimisation but a requirement: the global
    # gzip_types is commented out in nginx.conf, so runtime gzip would cover only
    # text/html and the 1.5 MB geometry blob would ship raw.
    gzip_static on;
    gzip_vary on;

    # Nothing is loaded from another origin, so the policy can be strict.
    # 'wasm-unsafe-eval' is load-bearing: without it the browser refuses to
    # instantiate the WebAssembly module and the page boots to a blank canvas.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control $tm6502_cache always;

    # This nginx has no `webmanifest` entry in mime.types, so the file would go
    # out as application/octet-stream and the browser would decline to install
    # the app. Set it here rather than editing the shared mime.types, which
    # every other site on the box also reads.
    #
    # Note this location deliberately declares no add_header: adding one would
    # discard every inherited security header, as it did once already.
    location ~* \.webmanifest$ {
        default_type application/manifest+json;
    }

    # Releases are reachable only through the `current` symlink; there is no
    # reason to expose the archive or let anyone enumerate it.
    location /releases/ { return 404; }

    # The visual6502.org preservation mirror, published by
    # deploy/archive-deploy.sh. It sits beside releases/ rather than inside a
    # release: it is ~2.5 GB of third-party material that changes only when
    # something new is recovered, and copying that on every front-end deploy
    # would be absurd.
    #
    # Note this location declares no add_header, deliberately -- adding one
    # here would discard every inherited security header, as it did once
    # before. Cache-Control arrives through the $tm6502_cache map above.
    #
    # archive/full is a relative symlink into ../mirror/, which nginx follows
    # (disable_symlinks is off by default). autoindex stays off: the whole
    # point of the gallery is that the collection is browsable through pages
    # that carry attribution, not through a bare directory listing.
    location /archive/ {
        alias /var/www/6502.tinymachines.ai/archive/;
        autoindex off;
        try_files $uri $uri/ $uri/index.html =404;
    }

    # 6502 as a service: the stateless API, proxied to a local uvicorn run by
    # 6502-api.service (deploy/6502-api.service). Everything else on this
    # vhost is static files; this is the one application process, and it holds
    # no state -- the client's Machine object is the session -- so a restart
    # or a second instance loses nothing.
    #
    # These locations DO declare add_header, so per the rule at the top they
    # declare the COMPLETE set: the moment one add_header appears, every
    # inherited server-level header is discarded. The CSP differs from the
    # site's on purpose and cannot be shared with it: api.html is one
    # self-contained file carrying its own inline <style>, and the generated
    # /api/docs and /api/redoc load Swagger UI and ReDoc from jsdelivr with
    # inline bootstrap scripts (ReDoc also runs a blob: worker and pulls
    # Google Fonts). None of that survives the site's `style-src 'self'`.
    # The API's own responses are JSON, where the CSP is inert either way.
    #
    # uvicorn runs with --root-path /api, which is what makes the generated
    # docs ask for /api/openapi.json rather than /openapi.json; the trailing
    # slashes on both sides of proxy_pass strip the prefix on the way in.
    location = /api { return 301 /api/; }
    # The API responses that are static data: the die's node names, and the
    # atlas (its derived containers, their members, and the wiring between
    # them). The /api/ location below says no-store, which is right for
    # everything that reflects a POSTed machine and wrong for these, so this
    # location restates the full header set with a real cache life. It is a
    # regex rather than six near-identical exact blocks, because this file's
    # own rule at the top is that one add_header in a location discards every
    # inherited one, and six copies of the header set is six chances to drop
    # one. Regex locations are matched before prefix locations, so this beats
    # /api/ without needing to be exact.
    #
    # A regex location cannot carry a URI on proxy_pass, hence the rewrite:
    # the app serves /v1/..., the site publishes it under /api/v1/....
    # The CORS headers come from the app and pass through.
    location ~ ^/api/v1/(nodes|atlas|groups|tags|node|neighbors)(/|$) {
        # Findings issue 02: the largest transport win available, one stanza.
        # Runtime gzip, because these responses are dynamic; the static site
        # precompresses instead (gzip_static, see above). min_length spares
        # the tiny healthz/meta bodies.
        gzip on;
        gzip_types application/json;
        gzip_comp_level 5;
        gzip_min_length 860;
        gzip_vary on;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:6502;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "public, max-age=86400" always;
    }
    location /api/ {
        # Findings issue 02: the largest transport win available, one stanza.
        # Runtime gzip, because these responses are dynamic; the static site
        # precompresses instead (gzip_static, see above). min_length spares
        # the tiny healthz/meta bodies.
        gzip on;
        gzip_types application/json;
        gzip_comp_level 5;
        gzip_min_length 860;
        gzip_vary on;
        proxy_pass http://127.0.0.1:6502/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://fastapi.tiangolo.com; connect-src 'self'; worker-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        # Every response reflects the state POSTed a moment ago; caching any
        # of it would hand one client another client's machine.
        add_header Cache-Control "no-store" always;
    }

    # `$uri.html` lets every page answer to its bare path: /schematic serves
    # schematic.html, and so on for the other entry points. The extension form
    # keeps working, so no existing link breaks.
    #
    # It sits after `$uri` so a real file always wins, and before `$uri/` so a
    # page beats a same-named directory -- the order that bit the archive, where
    # a URL was both a page and a directory.
    location / { try_files $uri $uri.html $uri/ =404; }
}
