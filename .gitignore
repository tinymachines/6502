/target
/web/pkg
node_modules
__pycache__/

# Generated oracle: 5 MB of reference trace, rebuilt on demand.
# node tools/golden-trace/gen.js --steps 3000
/tools/golden-trace/golden.txt
/web/layout.bin

# cargo run -p v6502-netlist --bin export-blueprint -- web/blueprint.json
/web/blueprint.json

# cargo run -p v6502-netlist --bin export-blocks -- web/blocks.json
/web/blocks.json

# cargo run -p v6502-netlist --bin export-schematic -- web/schematic.json
/web/schematic.json
# cargo run -p v6502-netlist --bin export-graph -- web/graph.json
/web/graph.json
# node tools/export-groups.mjs
/web/groups.json

# cargo run --release -p v6502-sim --bin export-decode -- web/decode.json
/web/decode.json

# cargo run --release -p v6502-sim --bin export-timing -- web/timing.json
/web/timing.json

# Git metadata for the version footer, stamped at build time.
# python3 tools/build-info.py web --kind simulator
/web/build-info.json

# Operator-specific runbook: addresses, zone paths, local host details.
/deploy/HOSTING.local.md

# Hashed production bundle, produced by tools/build-web.py.
/dist

# visual6502.org preservation mirror. Everything here is fetched, not authored:
# ~2.3 GB of CC BY-NC-SA die photography plus the wiki recovered from the
# Wayback Machine. Kept out of git for the same reason extern/visual6502 is a
# submodule -- this repository does not redistribute NC-SA data, it points at
# it. The URL manifests in archive/urls/ ARE committed: they are the index that
# makes the mirror reproducible, and they are ours.
#   bash archive/tools/harvest-site.sh
#   python3 archive/tools/harvest-wiki.py
/archive/mirror
/archive/wiki-raw
/archive/public
/archive/cdx
/archive/cdx-full
/archive/wayback
/archive/*.log
/archive/harvest-wiki-failed.txt
/archive/harvest-wiki-nosource.txt

# Third-party reference manuals, fetched for checking claims against, never
# redistributed. Same reasoning as extern/ and archive/: this repo points at
# copyrighted material rather than carrying it. MOS Technology's manuals are
# hosted by 6502.org; fetch them with tools/fetch-reference.sh.
/reference

# Minted by games/tools/mint.py at deploy time, from rom/dierunner.s and
# art/tiles.chr, so it cannot go stale against either.
games/*.cart.gz

# The registry, when run from the checkout in development. Production keeps
# it in /var/lib/6502-registry, named by the systemd unit.
service/registry.db
service/registry.db-*

# The seven programs, assembled by tools/export-programs.mjs for anything
# that cannot run a browser.
web/programs.txt

# The ELK tool takes one dependency and does not vendor it.
tools/chip-elk/node_modules/

# The container diagrams, drawn by tools/chip-elk/run.sh. Generated, and the
# chip map does without them when they are absent.
web/chip-elk/

# The headless pack, minted from web/programs.js by games/tools/mint-pack.mjs;
# the registry is where it lives.
games/pack/
